function inRange(codepoint: number, ranges: WidthRange[]): boolean {
  let lo = 0;
  let hi = ranges.length - 1;
  while (lo <= hi) {
    const mid = (lo + hi) >> 1;
    const r = ranges[mid];
    if (codepoint < r.lo) {
      hi = mid - 1;
    } else if (codepoint > r.hi) {
      lo = mid + 1;
    } else {
      return true;
    }
  }
  return false;
}

export function wcwidth(codepoint: number): number {
  if (codepoint < 0) return 0;
  if (codepoint < 0x20) return 0;
  if (codepoint === 0x7F) return 0;
  if (codepoint >= 0x80 && codepoint < 0xA0) return 0;
  if (inRange(codepoint, ZERO_WIDTH_RANGES)) return 0;
  if (inRange(codepoint, DOUBLE_WIDTH_RANGES)) return 2;
  return 1;
}
